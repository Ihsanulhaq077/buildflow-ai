# Application
APP_NAME=BuildFlow AI
APP_ENV=development
APP_PORT=8000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://buildflow:buildflow_dev_password@localhost:5432/buildflow
DATABASE_URL_SYNC=postgresql+psycopg2://buildflow:buildflow_dev_password@localhost:5432/buildflow

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=buildflow
STORAGE_ACCESS_KEY=buildflow
STORAGE_SECRET_KEY=buildflow_dev_password

# LLM / AI
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# OCR
OCR_ENABLED=true

# WhatsApp (future)
WHATSAPP_API_KEY=

# Email (future)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=